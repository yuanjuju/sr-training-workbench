# Datasets and upstream checkouts are obtained from their original sources.
/datasets/
/SAFMN/
/CAMixerSR/
/BasicSR/

# Environments, caches, archives, and generated model files.
/.venv/
/.venv-*/
__pycache__/
*.py[cod]
*.zip
*.tar
*.tar.gz
*.part
*.tmp
*.pth
*.state
*.png
.DS_Store

# Curated experiment visuals are public; local exercise outputs remain local.
!/results/safmn_fft_pair_30k/results/**/*.png
!/learning/examples/**/*.png
/learning/outputs/

# Full upstream compatibility backups stay local; publish the small patch.
/results/safmn_fft_pair_30k/originals/

# Experiment output stays outside version control unless curated in results/.
/experiments/
/training_states/
/visualization/
